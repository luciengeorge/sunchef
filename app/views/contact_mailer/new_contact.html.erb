<style>
  body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    margin: 0;
    padding: 0;
  }
  .container {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    background-color: #ffffff;
    padding: 20px;
  }
  .header {
    text-align: center;
    padding: 20px 0;
    background-color: #ffb850;
    color: #ffffff;
  }
  .content {
    text-align: center;
    padding: 20px;
    line-height: 1.5;
  }
  .button {
    display: inline-block;
    background-color: #ffb850;
    color: #000000;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 5px;
  }
  .footer {
    text-align: center;
    padding: 20px;
    background-color: #f4f4f4;
    color: #ffb850;
  }
  a {
    color: #ffb850;
    text-decoration: none;
  }
</style>
<div class="container">
  <div class="header">
    <h1>Thank you for submitting your health form 🗒️</h1>
  </div>
  <div class="content">
    <p>Hi <%= @contact.first_name %> 👋</p>
    <p>Thank you for submitting your health form. I'll get back to you as soon as I can!</p>
    <p>If you need to review your form, you can find it here:</p>
    <%= link_to "Open health form", contact_url(@contact, token: @contact.token), class: "button", target: :blank %>
    <p>You can also book a call with me following this link:</p>
    <%= link_to 'calendly.com/by-sunchef', 'https://calendly.com/by-sunchef', class: "button", target: :blank %>
    <p>Speak soon!</p>
    <p>Sunchef ☀️</p>
  </div>
  <div class="footer">
    <p>&copy; <%= Date.today.year %> Sunchef. All rights reserved.</p>
  </div>
</div>
