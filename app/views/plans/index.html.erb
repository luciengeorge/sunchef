<% content_for :meta_title, "Sunchef | Packages" %>

<div id="plans" class="container-fluid">
  <section class="m-lg-5 mb-5 mt-5 plans-wrapper p-5 d-flex flex-column align-items-center jusitfy-content-center">
    <h1 class="smaller text-center">work with me</h1>
    <p class="default w-75 text-center">Every person is different and for that reason, my approach is very tailored to the individual at hand. In every program, my utmost priority is to create a safe space for you to share and create meaningful change. Before we start any program, please fill out the Health History Form. To get to know each other, I offer a 30 minute free session to assess the next steps.</p>
    <div class="d-flex flex-column flex-md-row align-items-center justify-content-around gap-plans">
    <% @plans.each_with_index do |plan, index| %>
      <%= render PlanComponent.new(plan: plan, color: @colors[index % @colors.size]) %>
    <% end %>

    </div>
  </section>
</div>
