<!DOCTYPE html>
<html>
  <head>
    <title>Sunchef</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render Shared::FlashComponent.new(notice:, alert:) %>
    <div class="min-body-height">
      <%= render Shared::NavbarComponent.new(user_signed_in: user_signed_in?) %>
      <%= yield %>
    </div>
    <%= render Shared::FooterComponent.new %>
  </body>
</html>
