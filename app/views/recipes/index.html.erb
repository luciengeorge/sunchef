<div id="recipes" class="container my-5">
  <div class="row m-0">
    <% @recipes.each_with_index do |recipe, index| %>
      <div class="col-12 col-md-6">
        <%= link_to recipe, class: "text-decoration-none" do %>
          <div class="d-flex align-items-center justify-content-center">
            <div class="recipe mb-5">
              <%= image_tag recipe.images.first&.url || "https://placehold.co/400", alt: recipe.name, class: "recipe__img mb-3" %>
              <div class="d-flex align-items-center justify-content-end recipe-footer">
                 <div class="position-relative prep-time-wrapper" style="background-image: url('<%= image_url "prep-time-img-#{index % 8}.svg" %>');">
                  <p class="mb-0">🍳 <%= recipe.cooking_time %></p>
                </div>
                <div class="position-relative prep-time-wrapper" style="background-image: url('<%= image_url "prep-time-img-#{index % 8}.svg" %>');">
                  <p class="mb-0">🧑‍🍳 <%= recipe.prep_time %></p>
                </div>
                <div class="position-relative category-wrapper" style="background-image: url('<%= image_url "category-img-#{index % 8}.svg" %>')">
                  <p class="mb-0"><%= recipe.category.humanize.upcase %></p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <% if @recipes.empty? %>
      <em>We're in the process of cooking many many yummy recipes! Watch this page!</em>
    <% end %>
  </div>
</div>
