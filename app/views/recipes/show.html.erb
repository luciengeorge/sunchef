<% content_for :meta_title, "Sunchef | #{@recipe.name}" %>

<div id="recipe_show" class="mt-5">
  <section class="top-section position-relative">
    <%= image_tag "recipe.svg", alt: "recipe", class: "recipe-img" %>
    <div class="d-flex flex-column align-items-center justify-content-center w-100 h-100">
      <%= image_tag "sparkles.svg", alt: "sparkles", class: "sparkles" %>
      <h3 class="recipe-title"><%= @recipe.name %></h3>
      <%= image_tag "recipe-under-title.svg", alt: "recipe under title", class: 'recipe-under-title' %>
    </div>
  </section>
  <% if @recipe.images.first.present? %>
    <%= image_tag @recipe.images.first.variant(:show), alt: "Recipe image", class: 'recipe-show-img' %>
  <% end %>
  <section class="ingredients">
    <div class="d-flex align-items-center justify-content-between">
      <div>
        <h3 class="title">INGREDIENTS</h3>
        <%= image_tag "sparkle.svg", alt: "sparkle", class: "sparkle" %>
      </div>
      <div class="d-flex flex-column align-items-center justify-content-center">
        <%= image_tag "sparkles.svg", alt: "sparkles", class: "ingredient-recipe-sparkles" %>
        <h5 class="ingredient-recipe-title"><%= @recipe.name %></h5>
        <p class="ingredient-recipe-servings">serves <%= @recipe.servings %></p>
      </div>
    </div>
    <% @recipe.ingredients.each do |ingredient| %>
      <div class="d-flex align-items-center mb-3">
        <%= image_tag "sparkle.svg", alt: "sparkle", class: "ingredient-sparkle me-3" %>
        <p class="mb-0"><%= ingredient.description %></p>
      </div>
    <% end %>
  </section>
  <% if @recipe.images.second.present? %>
    <%= image_tag @recipe.images.second.variant(:show), alt: "Recipe image", class: 'recipe-show-img' %>
  <% end %>
  <section class="instructions">
    <h3 class="title">INSTRUCTIONS</h3>
    <% @recipe.instructions.each do |instruction| %>
      <div class="d-flex align-items-center mb-3">
        <%= image_tag "sparkle.svg", alt: "sparkle", class: "ingredient-sparkle me-3" %>
        <p class="mb-0"><%= instruction.description %></p>
      </div>
    <% end %>
  </section>
  <div class="d-flex align-items-center justify-content-center p-3">
    <%= image_tag "sparkle.svg", alt: "sparkle", class: "ingredient-sparkle me-2" %>
    <p class="mb-0 from-my-belly-to-yours">From my belly to yours</p>
    <%= image_tag "sparkle.svg", alt: "sparkle", class: "ingredient-sparkle ms-2" %>
  </div>

  <section id="youtube" class="my-5 <%= @recipe.instagram_embed.blank? ? 'd-none' : 'd-flex' %> align-items-center justify-content-center">
    <%= @recipe.instagram_embed&.html_safe %>
  </section>
</div>
