<div id="home">
  <div class="position-relative">
    <section class="intro">
      <div class="container d-flex flex-column align-items-center justify-content-center h-100">
        <div class="title d-flex flex-column align-items-center justify-content-center">
          <h1 class="mb-0">find</h1>
          <h1 class="mb-0">your</h1>
          <h1 class="mb-0 title--red">balance.</h1>
        </div>
        <%= image_tag "home-illustration.svg", alt: "illustration", class: 'illustration' %>
      </div>
    </section>
    <section class="pink_section">
      <div class="d-flex flex-column align-items-center justify-content-center h-100">
        <p class="text-white mb-0">A portal to your favorite deliciously</p>
        <p class="text-white mb-0">nutritious recipes and the first step </p>
        <p class="text-white mb-0">towards a balanced mind, body,</p>
        <p class="text-white mb-0">and soul through holistic health</p>
        <p class="text-white mb-0">coaching!  </p>
      </div>
    </section>
    <section class="middle__section d-flex flex-column align-items-center justify-content-center position-relative">
      <%= image_tag "sparkles.svg", alt: "sparkles", class: "sparkles" %>
      <h3 class="subtitle">A serving of mindfulness and a dash of willpower</h3>
      <h3 class="subtitle">will help bring out the best in you!</h3>
    </section>
  </div>
  <section class="position-relative">
    <div class="grid__image__wrapper w-100 position-absolute d-flex align-items-center justify-content-center">
      <%#= image_tag "mushroom.png", alt: "mushroom", class: "grid__mushroom d-none d-md-inline-block" %>
      <%= render MushroomComponent.new %>
    </div>
    <div class="row m-0">
      <div class="col-12 col-md-6 m-0 grid grid__top__left d-flex flex-column align-items-center align-items-md-start justify-content-end">
        <div>
          <h2 class="mb-0">show</h2>
          <h2 class="mb-0">up for</h2>
          <h2>yourself*</h2>
        </div>
      </div>
      <div class="col-12 col-md-6 m-0 grid grid__top__right d-flex flex-column align-items-center align-items-md-start justify-content-end">
        <div>
          <h2 class="mb-0">live &</h2>
          <h2>let live*</h2>
        </div>
      </div>
      <div class="col-12 col-md-6 m-0 grid grid__bottom__left d-flex flex-column align-items-center align-items-md-start justify-content-end">
        <div>
          <h2 class="mb-0">get</h2>
          <h2 class="mb-0">uncomfort-</h2>
          <h2>able*</h2>
        </div>
      </div>
      <div class="col-12 col-md-6 m-0 grid grid__bottom__right d-flex flex-column align-items-center align-items-md-start justify-content-end">
        <div>
          <h2 class="mb-0">find your</h2>
          <h2>balance*</h2>
        </div>
      </div>
    </div>

  </section>
  <section class="vh-100 position-relative breakfast__section">
    <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex align-items-center justify-content-center flex-column text-white">
      <div class="d-flex align-items-start flex-column">
        <h2 class="breakfast__section--title-top mb-n3">latest</h2>
        <h2 class="breakfast__section--title-bottom ">breakfast</h2>
      </div>
      <%= button_tag "Click here", class: "breakfast-btn" %>
      </div>
    </div>
  </section>
</div>
