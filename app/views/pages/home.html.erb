<div id="home">
  <section class="intro">
    <div class="container">
      <div class="d-flex align-items-center justify-content-center">
        <div class="w-50 d-flex justify-content-center">
          <%= image_tag "garlic.svg", class: "intro__svg" %>
        </div>
        <div class="w-50">
          <p>A portal to deliciously nutritious recipes and the first step towards a balanced mind, body, and soul through holistic health coaching! </p>
        </div>
      </div>
    </div>
  </section>
  <section class="find_your_balance__section">
    <div class="d-flex flex-column align-items-center">
      <div class="title">
        <h1 class="mb-0">find</h1>
        <h1 class="mb-0">your</h1>
        <h1 class="mb-0 title--red">balance.</h1>
      </div>
    </div>
  </section>
  <section class="middle__section d-flex flex-column align-items-center justify-content-center position-relative">
    <%= image_tag "garlic.svg", alt: "garlic", class: "sparkles mb-5" %>
    <%= image_tag "illustration.png", alt: "madame", class: "position-absolute illustration" %>
    <h3 class="subtitle mb-0">A serving of mindfulness and a dash of willpower</h3>
    <h3 class="subtitle">will help bring out the best in you!</h3>
  </section>
  <section class="position-relative">
    <div class="grid__image__wrapper w-100 position-absolute d-flex align-items-center justify-content-center">
      <%= image_tag "garlic.svg", alt: "garlic", class: "grid__svg" %>
    </div>
    <div class="row m-0">
      <div class="col-6 m-0 grid grid__top__left d-flex flex-column align-items-start justify-content-end">
        <div class="ms-4">
          <h2 class="mb-0">show</h2>
          <h2 class="mb-0">up for</h2>
          <h2>yourself*</h2>
        </div>
      </div>
      <div class="col-6 m-0 grid grid__top__right d-flex flex-column align-items-start justify-content-end">
        <div class="ms-5">
          <h2 class="mb-0">live &</h2>
          <h2>let live*</h2>
        </div>
      </div>
      <div class="col-6 m-0 grid grid__bottom__left d-flex flex-column align-items-start justify-content-end">
        <div class="ms-4">
          <h2 class="mb-0">get</h2>
          <h2 class="mb-0">uncomfort-</h2>
          <h2>able*</h2>
        </div>
      </div>
      <div class="col-6 m-0 grid grid__bottom__right d-flex flex-column align-items-start justify-content-end">
        <div class="ms-5">
          <h2 class="mb-0">find your</h2>
          <h2>balance*</h2>
        </div>
      </div>
    </div>

  </section>
  <section class="my-4 vh-100 position-relative breakfast__section">
    <div class="position-absolute top-0 bottom-0 start-0 end-0 d-flex align-items-center justify-content-center text-white">
      <div class="d-flex align-items-start flex-column">
        <h2 class="ps-5 breakfast__section--title-top mb-n3">latest</h2>
        <h2 class="breakfast__section--title-bottom ">breakfast</h2>
        <%= button_tag "Click here", class: "breakfast-btn" %>
      </div>
    </div>
  </section>
</div>
