<% content_for :meta_title, "Sunchef | Thank you" %>

<div class="container d-flex align-items-center justify-content-center my-5" id="new_contact">
  <div class="row m-0">
    <div class="col-12">
      <div class="form-intro rounded-5 p-3 px-5 mb-5">
        <p>Hello <%= @contact.first_name %>,</p>
        <p>Thank you for taking the time to fill out the form. It will help me to better undestand your needs and prepare for our call.</p>
        <p>I invite you to book our first introductory call by following this link <%= link_to 'calendly.com/by-sunchef', 'https://calendly.com/by-sunchef', target: '_blank' %></p>
        <p>Wishing you a lovely day,</p>
        <p>Soraya ☀️</p>
      </div>
    </div>
  </div>
</div>
