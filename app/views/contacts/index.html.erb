<% content_for :meta_title, "Sunchef | Forms" %>

<div class="container my-5" id="contacts_index">
  <div class="row">
    <% @contacts.each do |contact| %>
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        <%= render(ContactComponent.new(contact: contact)) %>
      </div>
    <% end %>
  </div>
</div>
