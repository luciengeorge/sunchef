<footer id="footer" class="py-5">
  <%= image_tag "blobs-footer.svg", alt: "blobs", class: "blobs-footer" %>
  <div class="container">
    <div class="row w-100">
      <div class="col-10 col-md-8 offset-1 offset-md-2">
        <div class="d-flex justify-content-center align-items-center">
          <div>
            <h6 class="footer--title">sunchef</h6>
            <h3 class="footer--tagline">
              i don't answer when i'm hangry
              <%= image_tag 'asterix.png', alt: 'asterix', class: 'footer--asterix' %>
            </h3>
            <p class="footer--paragraph mb-0">If you're curious and hungry for more, reach out! Take that first step.</p>
            <p class="footer--paragraph">Let's connect!</p>
            <%= button_tag "sunchef my life asap", class: "footer-btn" %>
            <p class="footer--notice"><abbr><strong>*</strong></abbr> but try your luck anyway</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
