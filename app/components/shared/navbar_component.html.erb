<nav class="container">
  <div id="navbar" class="d-flex justify-content-around align-items-center">
    <div class="navbar__left d-flex justify-content-around align-items-center">
      <%= link_to "home", root_path, class: class_names("navbar__link", active: current_page?(root_path)) %>
      <%= link_to "about", about_path, class: class_names("navbar__link", active: current_page?(about_path)) %>
    </div>
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "Sunchef Logo", class: "logo" %>
    <% end %>
    <div class="navbar__right d-flex justify-content-around align-items-center">
      <%= link_to "cook", cook_path, class: class_names("navbar__link", active: current_page?(cook_path)) %>
      <%= link_to "coaching", coaching_path, class: class_names("navbar__link", active: current_page?(coaching_path)) %>
      <%= link_to "shop", shop_path, class: class_names("navbar__link", active: current_page?(shop_path)) %>
      <% if user_signed_in %>
        <%= link_to "sign out", destroy_user_session_path, data: {turbo_method: :delete}, class: "navbar__link" %>
      <% end %>
    </div>
  </div>
</nav>
