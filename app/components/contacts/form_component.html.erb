<%= simple_form_for contact, html: { data: {contact_form_target: "form", action: "ajax:success->contact-form#success ajax:error->contact-form#error turbo:submit-end->contact-form#submitEnd"}} do |f| %>
      <div class="row m-0">
        <div class="col-12">
          <p>hello sunshine,</p>
          <p>please fill the Health History Form below. Once I receive it, I will contact you on the email you provided and we will schedule a FREE 30 minutes call to decide how to proceed.</p>
          <p>Let me know if you have any questions.</p>
          <p>Kind regards,</p>
          <p>Soraya ☀️</p>
          <%= f.input :gender, as: :select, label: "First, choose your gender to fill out the appropriate form 👇", collection: Contact.genders.keys, label_method: lambda { |gender| gender.humanize }, prompt: "Pick your gender", input_html: { data: { action: "change->contact-form#toggleGender" } } %>
          <h3>HEALTH HISTORY <span data-contact-form-target="word">MEN</span></h3>
          <div class="underline"></div>
          <h5>PERSONAL INFORMATION</h5>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12 col-md-6">
          <%= f.input :first_name, placeholder: "John", input_html: { data: { contact_form_target: "firstName" } } %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :last_name, placeholder: "Smith" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :email, placeholder: "johnsmith@gmail.com", input_html: { data: { contact_form_target: "email" } } %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :phone, placeholder: "+9613456789" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :birthdate, html5: true %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :place_of_birth, placeholder: "Beirut" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :height, placeholder: "165", hint: "in cm" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :current_weight, placeholder: "50", hint: "in kg" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :weight_six_month_ago, placeholder: "50", hint: "in kg" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :weight_one_year_ago, placeholder: "50", hint: "in kg" %>
        </div>
        <div class="col-12">
          <%= f.input :weight_change, as: :radio_buttons, label: "Would you like your weight to be different?" %>
        </div>
        <div class="col-12">
          <%= f.input :weight_goal, label: "If so, what?", placeholder: "Tell me more..." %>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12">
          <h5>SOCIAL INFORMATION</h5>
          <%= f.input :address, label: "Where do you currently live?", placeholder: "123 rue du Liban" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :occupation, placeholder: "Health coach" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :hours_of_work_per_week, placeholder: "40" %>
        </div>
        <div class="col-12">
          <%= f.input :relationship_status, as: :select, collection: Contact.relationship_statuses.keys, label_method: lambda { |status| status.humanize }, prompt: "Pick one" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :children, placeholder: "4" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :pets, placeholder: "1" %>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12">
          <h5>HEALTH INFORMATION</h5>
          <%= f.input :health_concerns, label: "Please list your main health concerns", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :other_concerns_or_goals, label: "Other concerns and/or goals?", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :best_point_in_life, label: "At what point in your life did you feel best?", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :health_of_mother, label: "How is/was the health of your mother?", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :health_of_father, label: "How is/was the health of your father?", placeholder: "Give details..." %>
        </div>
        <div class="col-6">
          <%= f.input :sleep_condition, label: "How is your sleep?", placeholder: "Sleep like a baby" %>
        </div>
        <div class="col-6">
          <%= f.input :hours_of_sleep, label: "How many hours?", placeholder: "7" %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :wake_up_at_night, as: :radio_buttons, label: "Do you wake up at night?" %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :wake_up_at_night_reason, label: "Why?", placeholder: "Give details..." %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :serious_illnesses, as: :radio_buttons, label: "Any serious illnesses/hospitalizations/injuries?" %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :pain_stiffness_or_swelling, as: :radio_buttons, label: "Any pain, stiffness or swelling?" %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :constipation_diarrhea_or_gas, as: :radio_buttons, label: "Constipation/Diarrhea/Gas?" %>
        </div>
        <div class="col-12 col-lg-6">
          <%= f.input :allergies_or_sensitivities, as: :radio_buttons, label: "Allergies or sensitivities?" %>
        </div>
        <div class="col-12">
          <%= f.input :allergies_or_sensitivities_explanation, label: "Please explain", placeholder: "Give details..." %>
        </div>
      </div>
      <div class="row m-0 <%= contact.female? ? '' : 'd-none' %>" data-contact-form-target="women">
        <div class="col-12 col-md-6">
          <h5>WOMEN'S HEALTH</h5>
          <%= f.input :regular_periods, as: :radio_buttons, label: "Are your periods regular?" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :flow_days, label: "How many days in your flow", placeholder: "5" %>
        </div>
        <div class="col-12">
          <%= f.input :frequency, label: "How frequent?", placeholder: "28 days" %>
        </div>
        <div class="col-12">
          <%= f.input :painful_or_symptomatic, as: :radio_buttons, label: "Painful or symptomatic?" %>
        </div>
        <div class="col-12">
          <%= f.input :painful_or_symptomatic_explanation, label: "Please explain", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :reached_or_approaching_menopause, as: :radio_buttons, label: "Reached or approaching menopause?" %>
        </div>
        <div class="col-12">
          <%= f.input :birth_control_history, placeholder: "Give details" %>
        </div>
        <div class="col-12">
          <%= f.input :yeast_infection_or_urinary_tract_infections, as: :radio_buttons, label: "Do you experience yeast infections or urinary tract infections?" %>
        </div>
        <div class="col-12">
          <%= f.input :yeast_infection_or_urinary_tract_infections_explanation, label: "Please explain", placeholder: "Give details..." %>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12">
          <h5>MEDICAL INFORMATION</h5>
          <%= f.input :supplements_or_medications, as: :radio_buttons, label: "Do you take any supplements or medications?" %>
        </div>
        <div class="col-12">
          <%= f.input :supplements_or_medications_list, label: "Please list", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :healers_helpers_or_therapies, as: :radio_buttons, label: "Any healers, helpers, or therapies with which you are involved?" %>
        </div>
        <div class="col-12">
          <%= f.input :healers_helpers_or_therapies_list, label: "Please list", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.input :role_of_sports, label: "What role do sports and exercise play in your life?", placeholder: "Give details..." %>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12">
          <h5>FOOD INFORMATION</h5>
          <p>What is your food like these days?</p>
          <%= f.input :breakfast, placeholder: "List here..." %>
        </div>
        <div class="col-12">
          <%= f.input :lunch, placeholder: "List here..." %>
        </div>
        <div class="col-12">
          <%= f.input :dinner, placeholder: "List here..." %>
        </div>
        <div class="col-12">
          <%= f.input :snacks, placeholder: "List here..." %>
        </div>
        <div class="col-12">
          <%= f.input :liquids, placeholder: "List here..." %>
        </div>
        <div class="col-12">
          <%= f.input :support_from_family, as: :radio_buttons, label: "Will family and/or friends be supportive of your desire to make food and/or lifestyle changes?" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :cooks, as: :radio_buttons, label: "Do you cook?" %>
        </div>
        <div class="col-12 col-md-6">
          <%= f.input :home_cooked_percentage, label: "What percentage of your food is home cooked?", placeholder: "75", hint: "in %" %>
        </div>
        <div class="col-12">
          <%= f.input :craving_sugar_cigarettes_or_addictions, as: :radio_buttons, label: "Do you crave sugar, coffee, cigarettes, or have any major addictions?" %>
        </div>
        <div class="col-12">
          <%= f.input :most_important_improvements, label: "The most important thing I should do to improve my health is", placeholder: "Give details..." %>
        </div>
      </div>
      <div class="row m-0">
        <div class="col-12">
          <h5>ADDITIONAL COMMENTS</h5>
          <%= f.input :additional_comment, label: "Anything else you would like to share?", placeholder: "Give details..." %>
        </div>
        <div class="col-12">
          <%= f.submit "Submit", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
